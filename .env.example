# ─────────────────────────────────────────────────────────────
# DATABASE
# Prisma runtime connection through Supabase pooler
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&sslmode=require
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.kiguxtgtdtdnvtjphekb:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Supabase Postgres connection for Prisma migrations
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DIRECT_URL="postgresql://postgres.kiguxtgtdtdnvtjphekb:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# NEXT AUTH
# Must be a random 32+ character string — generate with:
#   openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# Full URL where the app is hosted (no trailing slash)
NEXTAUTH_URL="https://autoankauf.de"

# ─────────────────────────────────────────────────────────────
# EMAIL — RESEND
# ─────────────────────────────────────────────────────────────
# Resend API key (starts with: re_)
RESEND_API_KEY="re_CHANGE_ME"
# Sender address shown in outgoing emails (must be verified in Resend)
RESEND_FROM="Autoankauf Deutschland <noreply@autoankauf.de>"
# Optional brand name used in email templates
EMAIL_BRAND_NAME="Autoankauf Deutschland"

# Admin inbox that receives new lead notifications
ADMIN_EMAIL="admin@autoankauf.de"

# One-time admin setup secret (send in header: x-setup-token)
SETUP_ADMIN_TOKEN="CHANGE_ME_STRONG_SETUP_TOKEN"

# ─────────────────────────────────────────────────────────────
# PUBLIC SITE URL (exposed to the browser via NEXT_PUBLIC_*)
# Used for CSRF checks and email deep-links
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_URL="https://autoankauf.de"

# ─────────────────────────────────────────────────────────────
# ENVIRONMENT
# Always set to "production" on the server
# ─────────────────────────────────────────────────────────────
NODE_ENV="production"

# ─────────────────────────────────────────────────────────────
# ANALYTICS (optional)
# Uncomment and fill in if you use Plausible or Google Analytics
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="autoankauf.de"
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
