# ─────────────────────────────────────────────────────────────
# DATABASE
# MySQL connection string for Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# ─────────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:password@localhost:3306/autoankauf"

# ─────────────────────────────────────────────────────────────
# NEXT AUTH
# Must be a random 32+ character string — generate with:
#   openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# Full URL where the app is hosted (no trailing slash)
NEXTAUTH_URL="https://autoankauf.de"

# ─────────────────────────────────────────────────────────────
# EMAIL — SMTP
# ─────────────────────────────────────────────────────────────
# SMTP host (example: smtp.mailprovider.com)
SMTP_HOST="smtp.example.com"
# SMTP port (465 for SSL, 587 for STARTTLS)
SMTP_PORT="465"
# true for implicit TLS (usually 465), false for STARTTLS/plain (usually 587)
SMTP_SECURE="true"
# SMTP authentication username
SMTP_USER="noreply@autoankauf.de"
# SMTP authentication password
SMTP_PASS="CHANGE_ME_SMTP_PASSWORD"
# Sender address shown in outgoing emails
SMTP_FROM="Autoankauf Deutschland <noreply@autoankauf.de>"
# Optional brand name used in email templates
EMAIL_BRAND_NAME="Autoankauf Deutschland"

# Admin inbox that receives new lead notifications
ADMIN_EMAIL="admin@autoankauf.de"

# One-time admin setup secret (send in header: x-setup-token)
SETUP_ADMIN_TOKEN="CHANGE_ME_STRONG_SETUP_TOKEN"

# ─────────────────────────────────────────────────────────────
# PUBLIC SITE URL (exposed to the browser via NEXT_PUBLIC_*)
# Used for CSRF checks and email deep-links
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_URL="https://autoankauf.de"

# ─────────────────────────────────────────────────────────────
# ENVIRONMENT
# Always set to "production" on the server
# ─────────────────────────────────────────────────────────────
NODE_ENV="production"

# ─────────────────────────────────────────────────────────────
# ANALYTICS (optional)
# Uncomment and fill in if you use Plausible or Google Analytics
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="autoankauf.de"
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
