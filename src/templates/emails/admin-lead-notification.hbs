<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Neue Lead-Anfrage</title>
  </head>
  <body style="margin:0;padding:0;background:#f3f4f6;font-family:Arial,Helvetica,sans-serif;color:#111827;">
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background:#f3f4f6;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:700px;background:#ffffff;border-radius:14px;overflow:hidden;">
            <tr>
              <td style="padding:24px 28px;background:linear-gradient(135deg,#7c2d12,#b45309);color:#ffffff;">
                <p style="margin:0 0 8px;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;opacity:0.95;">Neue Anfrage</p>
                <h1 style="margin:0;font-size:25px;line-height:1.3;font-weight:700;">{{carMake}} {{carModel}} ({{carYear}})</h1>
                <p style="margin:12px 0 0;font-size:15px;line-height:1.6;color:#ffedd5;">
                  Ein neuer Lead wurde uber {{brandName}} eingereicht.
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding:24px 28px;">
                <h2 style="margin:0 0 12px;font-size:18px;color:#0f172a;">Kundendaten</h2>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;">
                  <tr>
                    <td style="padding:11px 14px;background:#f9fafb;font-size:14px;color:#6b7280;">Name</td>
                    <td style="padding:11px 14px;font-size:14px;color:#111827;font-weight:600;">{{firstName}} {{lastName}}</td>
                  </tr>
                  <tr>
                    <td style="padding:11px 14px;background:#f9fafb;font-size:14px;color:#6b7280;">E-Mail</td>
                    <td style="padding:11px 14px;font-size:14px;color:#111827;font-weight:600;">{{email}}</td>
                  </tr>
                  <tr>
                    <td style="padding:11px 14px;background:#f9fafb;font-size:14px;color:#6b7280;">Telefon</td>
                    <td style="padding:11px 14px;font-size:14px;color:#111827;font-weight:600;">{{phone}}</td>
                  </tr>
                  <tr>
                    <td style="padding:11px 14px;background:#f9fafb;font-size:14px;color:#6b7280;">Bevorzugter Kontakt</td>
                    <td style="padding:11px 14px;font-size:14px;color:#111827;font-weight:600;">{{preferredContact}}</td>
                  </tr>
                </table>

                <h2 style="margin:24px 0 12px;font-size:18px;color:#0f172a;">Fahrzeugdaten</h2>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;">
                  <tr>
                    <td style="padding:11px 14px;background:#f9fafb;font-size:14px;color:#6b7280;">Marke / Modell</td>
                    <td style="padding:11px 14px;font-size:14px;color:#111827;font-weight:600;">{{carMake}} {{carModel}}</td>
                  </tr>
                  <tr>
                    <td style="padding:11px 14px;background:#f9fafb;font-size:14px;color:#6b7280;">Baujahr</td>
                    <td style="padding:11px 14px;font-size:14px;color:#111827;font-weight:600;">{{carYear}}</td>
                  </tr>
                  <tr>
                    <td style="padding:11px 14px;background:#f9fafb;font-size:14px;color:#6b7280;">Kilometerstand</td>
                    <td style="padding:11px 14px;font-size:14px;color:#111827;font-weight:600;">{{formatNumber carMileage}} km</td>
                  </tr>
                  <tr>
                    <td style="padding:11px 14px;background:#f9fafb;font-size:14px;color:#6b7280;">Preisvorschlag Kunde</td>
                    <td style="padding:11px 14px;font-size:14px;color:#111827;font-weight:600;">{{formatCurrency offeredPrice}}</td>
                  </tr>
                </table>

                {{#if notes}}
                <h2 style="margin:24px 0 12px;font-size:18px;color:#0f172a;">Anmerkungen</h2>
                <div style="padding:14px;border:1px solid #e5e7eb;border-radius:10px;background:#fcfcfc;font-size:14px;line-height:1.7;color:#374151;white-space:pre-wrap;">{{notes}}</div>
                {{/if}}

                <p style="margin:20px 0 0;font-size:13px;color:#6b7280;">
                  Eingegangen am: <strong style="color:#111827;">{{formatDateTime submittedAt}}</strong>
                </p>

                {{#if adminLeadUrl}}
                <p style="margin:22px 0 0;">
                  <a href="{{adminLeadUrl}}" style="display:inline-block;padding:12px 18px;background:#0f172a;color:#ffffff;text-decoration:none;border-radius:8px;font-size:14px;font-weight:600;">
                    Lead im Admin-Bereich offnen
                  </a>
                </p>
                {{/if}}
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
